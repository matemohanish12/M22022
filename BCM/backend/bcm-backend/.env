# Sample .env for local Postgres development
# Update values to match your local/postgres service
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=bcm
# Use sqlite instead by setting USE_SQLITE=true
USE_SQLITE=false
# SKIP_DB=true disables DB and uses in-memory fallbacks
SKIP_DB=false
# DEV_SYNC=true enables TypeORM synchronize (dev only) to auto-create schema
DEV_SYNC=true
# Application port
PORT=3000
